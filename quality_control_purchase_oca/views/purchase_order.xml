<odoo>

    <record model="ir.actions.act_window" id="action_qc_inspection_per_purchase">
        <field name="name">Quality inspections from purchase order</field>
        <field name="res_model">qc.inspection</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('purchase_id', '=', active_id)]</field>
        <field
            name="context"
        >{'default_object_id': 'purchase.order,' + str(active_id)}</field>
    </record>

    <record model="ir.ui.view" id="purchase_order_form_view">
        <field name="name">purchase.order.form (in quality_control_purchase_oca)</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field
            name="groups_id"
            eval="[(4, ref('quality_control_oca.group_quality_control_user'))]"
        />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_inline oe_stat_button"
                    type="action"
                    name="%(action_qc_inspection_per_purchasen)d"
                    icon="fa-bookmark-o"
                >
                    <field
                        name="created_inspections"
                        widget="statinfo"
                        string="inspections"
                    />
                </button>
            </div>
        </field>
    </record>

</odoo>
