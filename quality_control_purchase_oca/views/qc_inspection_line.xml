<odoo>

    <record model="ir.ui.view" id="qc_inspection_line_search_view">
        <field
            name="name"
        >qc.inspection.line.search (in quality_control_purchase_oca)</field>
        <field name="model">qc.inspection.line</field>
        <field
            name="inherit_id"
            ref="quality_control_oca.qc_inspection_line_search_view"
        />
        <field
            name="groups_id"
            eval="[(4, ref('mrp.group_mrp_user'))]"
        /> <!-- TODO: mudar -->
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="purchase_id" />
            </field>
            <group expand="0" position="inside">
                <filter
                    string="Purchase order"
                    name="groupby_purchases"
                    domain="[]"
                    context="{'group_by': 'purchase_id'}"
                />
            </group>
        </field>
    </record>

    <record model="ir.ui.view" id="qc_inspection_line_tree_view">
        <field
            name="name"
        >qc.inspection.line.tree (in quality_control_purchase_oca)</field>
        <field name="model">qc.inspection.line</field>
        <field
            name="inherit_id"
            ref="quality_control_oca.qc_inspection_line_tree_view"
        />
        <field
            name="groups_id"
            eval="[(4, ref('mrp.group_mrp_user'))]"
        /> <!-- TODO: mudar -->
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="purchase_id" />
            </field>
        </field>
    </record>

</odoo>
