<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="mrp_production_form_view_fixed_component_qty" model="ir.ui.view">
        <field name="name">mrp.production.form.fixed.component.qty</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='move_raw_ids']//field[@name='picked']"
                position="after"
            >
                <field
                    name="fixed_qty"
                    string="Fixed Qty"
                    optional="show"
                    readonly="parent.state in ('done', 'cancel')"
                />
            </xpath>
        </field>
    </record>
</odoo>
